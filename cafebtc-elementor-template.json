              "settings": {
                "html": "<style>@import url('https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;700;900&display=swap');.cafebtc-hero{position:relative;min-height:100vh;background:#090909;display:flex;align-items:center;overflow:hidden;font-family:'Vazirmatn',Tahoma,Arial,sans-serif;direction:rtl;}.cafebtc-hero *{box-sizing:border-box;}.hex-bg{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;}.orange-glow-left{position:absolute;left:-100px;top:50%;transform:translateY(-50%);width:700px;height:700px;background:radial-gradient(circle,rgba(200,88,8,0.45) 0%,transparent 65%);pointer-events:none;animation:glowPulse 5s ease-in-out infinite;}.hero-inner{position:relative;z-index:10;width:100%;max-width:1300px;margin:0 auto;padding:60px 40px;display:flex;align-items:center;justify-content:space-between;gap:60px;}.hero-text{flex:1;text-align:right;}.hero-visual{flex:0 0 360px;display:flex;flex-direction:column;align-items:center;gap:24px;}.price-badge{display:inline-flex;align-items:center;gap:10px;background:rgba(247,148,29,0.08);border:1px solid rgba(247,148,29,0.25);border-radius:50px;padding:8px 20px;margin-bottom:20px;}.price-badge-symbol{color:#f7941d;font-size:22px;font-weight:900;}.price-badge-value{color:#f7941d;font-size:18px;font-weight:700;font-variant-numeric:tabular-nums;}.price-badge-change{color:#26a65b;font-size:13px;font-weight:600;}.mini-chart{display:flex;align-items:flex-end;gap:3px;height:32px;margin-right:8px;}.candle{width:7px;border-radius:2px;}.candle.g{background:#26a65b;}.candle.r{background:#e74c3c;}.hero-title{font-size:clamp(38px,5vw,68px);font-weight:900;color:#fff;line-height:1.15;margin:0 0 12px;letter-spacing:-1px;}.hero-title span{color:#f7941d;}.hero-subtitle{font-size:clamp(16px,2.2vw,24px);color:#aaa;font-weight:300;margin:0 0 20px;}.hero-desc{font-size:15px;color:#666;line-height:1.9;margin:0 0 36px;max-width:520px;}.hero-btns{display:flex;gap:14px;flex-wrap:wrap;align-items:center;}.btn-primary{display:inline-flex;align-items:center;gap:8px;background:#f7941d;color:#000;padding:14px 32px;border-radius:50px;font-size:15px;font-weight:700;text-decoration:none;transition:all 0.3s;font-family:inherit;}.btn-primary:hover{background:#e8850e;transform:translateY(-2px);box-shadow:0 8px 30px rgba(247,148,29,0.4);}.btn-outline{display:inline-flex;align-items:center;gap:8px;background:transparent;color:#f7941d;padding:14px 32px;border-radius:50px;font-size:15px;font-weight:700;text-decoration:none;border:2px solid #f7941d;transition:all 0.3s;font-family:inherit;}.btn-outline:hover{background:rgba(247,148,29,0.1);transform:translateY(-2px);}.btc-icon-wrap{position:relative;display:flex;align-items:center;justify-content:center;width:200px;height:200px;}.btc-circle{width:120px;height:120px;background:linear-gradient(135deg,#f7941d,#c85808);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:68px;color:#fff;font-weight:900;line-height:1;box-shadow:0 0 80px rgba(247,148,29,0.55);animation:floatBTC 7s ease-in-out infinite;z-index:2;}.orbit1{position:absolute;inset:0;border:1.5px dashed rgba(247,148,29,0.25);border-radius:50%;animation:orbit 12s linear infinite;}.orbit2{position:absolute;width:170px;height:170px;border:1px dashed rgba(247,148,29,0.12);border-radius:50%;animation:orbit 20s linear infinite reverse;}.phone-mockup{width:185px;background:#181818;border:2px solid #2a2a2a;border-radius:32px;padding:14px;box-shadow:0 30px 80px rgba(0,0,0,0.9),0 0 0 1px rgba(255,255,255,0.03);}.phone-inner{background:#0b0b16;border-radius:20px;padding:18px 14px;text-align:center;}.phone-label{font-size:10px;color:#444;margin-bottom:8px;letter-spacing:1px;}.phone-price{font-size:22px;font-weight:700;color:#fff;margin-bottom:4px;font-variant-numeric:tabular-nums;}.phone-change{font-size:12px;color:#26a65b;margin-bottom:14px;}.phone-chart{display:flex;align-items:flex-end;gap:3px;height:55px;justify-content:center;padding:0 4px;}.site-label{text-align:center;}.site-name{font-size:15px;color:#f7941d;font-weight:700;margin-bottom:2px;}.site-url{font-size:11px;color:#444;}.scroll-hint{position:absolute;bottom:28px;left:50%;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:6px;animation:scrollBounce 2.5s ease-in-out infinite;}.scroll-line{width:1.5px;height:36px;background:linear-gradient(to bottom,#f7941d,transparent);}.scroll-dot{width:6px;height:6px;border:1.5px solid #f7941d;border-radius:50%;}@keyframes glowPulse{0%,100%{opacity:0.8;transform:translateY(-50%) scale(1);}50%{opacity:1;transform:translateY(-50%) scale(1.08);}}@keyframes floatBTC{0%,100%{transform:translateY(0) rotate(-3deg);}40%{transform:translateY(-18px) rotate(3deg);}75%{transform:translateY(-8px) rotate(-1deg);}}@keyframes orbit{from{transform:rotate(0deg);}to{transform:rotate(360deg);}}@keyframes scrollBounce{0%,100%{transform:translateX(-50%) translateY(0);}50%{transform:translateX(-50%) translateY(10px);}}@media(max-width:900px){.hero-inner{flex-direction:column;text-align:center;padding:80px 20px 40px;}.hero-text{text-align:center;}.hero-btns{justify-content:center;}}</style><div class='cafebtc-hero'><svg class='hex-bg' viewBox='0 0 1400 800' xmlns='http://www.w3.org/2000/svg' preserveAspectRatio='xMidYMid slice'><defs><radialGradient id='rg' cx='30%' cy='50%'><stop offset='0%' stop-color='#c85808' stop-opacity='0.5'/><stop offset='100%' stop-color='#090909' stop-opacity='0'/></radialGradient></defs><rect width='1400' height='800' fill='#090909'/><ellipse cx='380' cy='400' rx='400' ry='300' fill='url(#rg)'><animate attributeName='rx' values='400;450;400' dur='5s' repeatCount='indefinite'/><animate attributeName='ry' values='300;340;300' dur='5s' repeatCount='indefinite'/></ellipse><g stroke='#f7941d' stroke-width='1' fill='none'><polygon points='60,40 100,16 140,40 140,88 100,112 60,88'><animate attributeName='stroke-opacity' values='0.08;0.45;0.08' dur='3.2s' repeatCount='indefinite'/></polygon><polygon points='140,40 180,16 220,40 220,88 180,112 140,88'><animate attributeName='stroke-opacity' values='0.15;0.6;0.15' dur='4s' begin='0.5s' repeatCount='indefinite'/></polygon><polygon points='220,40 260,16 300,40 300,88 260,112 220,88'><animate attributeName='stroke-opacity' values='0.05;0.35;0.05' dur='3.5s' begin='1s' repeatCount='indefinite'/></polygon><polygon points='300,40 340,16 380,40 380,88 340,112 300,88'><animate attributeName='stroke-opacity' values='0.12;0.5;0.12' dur='4.5s' begin='0.3s' repeatCount='indefinite'/></polygon><polygon points='20,112 60,88 100,112 100,160 60,184 20,160'><animate attributeName='stroke-opacity' values='0.1;0.55;0.1' dur='2.8s' begin='0.8s' repeatCount='indefinite'/></polygon><polygon points='100,112 140,88 180,112 180,160 140,184 100,160'><animate attributeName='stroke-opacity' values='0.2;0.7;0.2' dur='3.8s' begin='0.2s' repeatCount='indefinite'/></polygon><polygon points='180,112 220,88 260,112 260,160 220,184 180,160'><animate attributeName='stroke-opacity' values='0.08;0.4;0.08' dur='5s' begin='1.2s' repeatCount='indefinite'/></polygon><polygon points='260,112 300,88 340,112 340,160 300,184 260,160'><animate attributeName='stroke-opacity' values='0.18;0.65;0.18' dur='3.1s' begin='0.6s' repeatCount='indefinite'/></polygon><polygon points='340,112 380,88 420,112 420,160 380,184 340,160'><animate attributeName='stroke-opacity' values='0.05;0.3;0.05' dur='4.2s' begin='1.5s' repeatCount='indefinite'/></polygon><polygon points='60,184 100,160 140,184 140,232 100,256 60,232'><animate attributeName='stroke-opacity' values='0.25;0.75;0.25' dur='2.6s' begin='0.4s' repeatCount='indefinite'/></polygon><polygon points='140,184 180,160 220,184 220,232 180,256 140,232'><animate attributeName='stroke-opacity' values='0.1;0.45;0.1' dur='3.6s' begin='1.1s' repeatCount='indefinite'/></polygon><polygon points='220,184 260,160 300,184 300,232 260,256 220,232'><animate attributeName='stroke-opacity' values='0.3;0.8;0.3' dur='3.3s' begin='0.7s' repeatCount='indefinite'/></polygon><polygon points='300,184 340,160 380,184 380,232 340,256 300,232'><animate attributeName='stroke-opacity' values='0.08;0.38;0.08' dur='4.8s' begin='0.1s' repeatCount='indefinite'/></polygon><polygon points='20,256 60,232 100,256 100,304 60,328 20,304'><animate attributeName='stroke-opacity' values='0.15;0.6;0.15' dur='3.7s' begin='0.9s' repeatCount='indefinite'/></polygon><polygon points='100,256 140,232 180,256 180,304 140,328 100,304'><animate attributeName='stroke-opacity' values='0.22;0.68;0.22' dur='2.9s' begin='0.3s' repeatCount='indefinite'/></polygon><polygon points='180,256 220,232 260,256 260,304 220,328 180,304'><animate attributeName='stroke-opacity' values='0.06;0.42;0.06' dur='4.4s' begin='1.4s' repeatCount='indefinite'/></polygon><polygon points='260,256 300,232 340,256 340,304 300,328 260,304'><animate attributeName='stroke-opacity' values='0.18;0.62;0.18' dur='3.4s' begin='0.5s' repeatCount='indefinite'/></polygon><polygon points='340,256 380,232 420,256 420,304 380,328 340,304'><animate attributeName='stroke-opacity' values='0.1;0.5;0.1' dur='5.2s' begin='0.8s' repeatCount='indefinite'/></polygon><polygon points='60,328 100,304 140,328 140,376 100,400 60,376'><animate attributeName='stroke-opacity' values='0.28;0.78;0.28' dur='3s' begin='0.6s' repeatCount='indefinite'/></polygon><polygon points='140,328 180,304 220,328 220,376 180,400 140,376'><animate attributeName='stroke-opacity' values='0.08;0.4;0.08' dur='4.1s' begin='1.3s' repeatCount='indefinite'/></polygon><polygon points='220,328 260,304 300,328 300,376 260,400 220,376'><animate attributeName='stroke-opacity' values='0.2;0.7;0.2' dur='3.2s' begin='0.2s' repeatCount='indefinite'/></polygon><polygon points='300,328 340,304 380,328 380,376 340,400 300,376'><animate attributeName='stroke-opacity' values='0.12;0.52;0.12' dur='4.6s' begin='1s' repeatCount='indefinite'/></polygon></g></svg><div class='hero-inner'><div class='hero-text'><div class='price-badge'><span class='price-badge-symbol'>&#8383;</span><span class='price-badge-value' id='cbPriceVal'>$67,842</span><span class='price-badge-change'>+2.4% &#9650;</span><div class='mini-chart'><div class='candle g' style='height:18px'></div><div class='candle r' style='height:13px'></div><div class='candle g' style='height:26px'></div><div class='candle r' style='height:16px'></div><div class='candle g' style='height:32px'></div><div class='candle g' style='height:28px'></div></div></div><h1 class='hero-title'>کافه <span>بیتکوین</span></h1><p class='hero-subtitle'>اولین کافه با پرداخت رمزارز در ایران</p><p class='hero-desc'>در کافه بیتکوین هر فنجان قهوه یک تجربه متفاوت است. ما پیشرو در پذیرش پرداخت با بیتکوین و رمزارزهای دیجیتال در ایران هستیم. بیایید آینده مالی را با یک قهوه خوب تجربه کنید.</p><div class='hero-btns'><a href='#menu' class='btn-primary'>مشاهده منو</a><a href='#about' class='btn-outline'>بیشتر بدانید</a></div></div><div class='hero-visual'><div class='btc-icon-wrap'><div class='orbit1'></div><div class='orbit2'></div><div class='btc-circle'>&#8383;</div></div><div class='phone-mockup'><div class='phone-inner'><div class='phone-label'>BTC / USDT</div><div class='phone-price'>$67,842</div><div class='phone-change'>+2.4% &#9650;</div><div class='phone-chart'><div class='candle g' style='height:22px'></div><div class='candle r' style='height:16px'></div><div class='candle g' style='height:34px'></div><div class='candle r' style='height:19px'></div><div class='candle g' style='height:44px'></div><div class='candle g' style='height:38px'></div><div class='candle r' style='height:14px'></div><div class='candle g' style='height:48px'></div><div class='candle r' style='height:24px'></div><div class='candle g' style='height:52px'></div></div></div></div><div class='site-label'><div class='site-name'>کافه بیتکوین</div><div class='site-url'>cafebtc.ir</div></div></div></div><div class='scroll-hint'><div class='scroll-line'></div><div class='scroll-dot'></div></div></div>"
