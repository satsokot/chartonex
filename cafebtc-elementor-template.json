                "html": "<style>.cafebtc-ticker{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px;max-width:1300px;margin:0 auto;padding:0 20px;font-family:'Vazirmatn',Tahoma,Arial,sans-serif;direction:rtl;}.ticker-item{display:flex;align-items:center;gap:10px;}.ticker-icon{width:36px;height:36px;background:rgba(247,148,29,0.1);border:1px solid rgba(247,148,29,0.2);border-radius:50%;display:flex;align-items:center;justify-content:center;color:#f7941d;font-size:16px;font-weight:900;}.ticker-info{display:flex;flex-direction:column;}.ticker-label{font-size:10px;color:#555;letter-spacing:0.5px;text-transform:uppercase;}.ticker-value{font-size:15px;font-weight:700;color:#fff;font-variant-numeric:tabular-nums;}.ticker-change{font-size:11px;}.ticker-change.up{color:#26a65b;}.ticker-change.dn{color:#e74c3c;}.ticker-divider{width:1px;height:36px;background:rgba(255,255,255,0.06);}@media(max-width:768px){.ticker-divider{display:none;}.cafebtc-ticker{justify-content:center;}}</style><div class='cafebtc-ticker'><div class='ticker-item'><div class='ticker-icon'>&#8383;</div><div class='ticker-info'><span class='ticker-label'>بیتکوین</span><span class='ticker-value'>$67,842</span><span class='ticker-change up'>+2.4%</span></div></div><div class='ticker-divider'></div><div class='ticker-item'><div class='ticker-icon' style='color:#8b5cf6;background:rgba(139,92,246,0.1);border-color:rgba(139,92,246,0.2);'>&#9830;</div><div class='ticker-info'><span class='ticker-label'>اتریوم</span><span class='ticker-value'>$3,218</span><span class='ticker-change up'>+1.8%</span></div></div><div class='ticker-divider'></div><div class='ticker-item'><div class='ticker-icon' style='color:#22d3ee;background:rgba(34,211,238,0.1);border-color:rgba(34,211,238,0.2);'>&#9670;</div><div class='ticker-info'><span class='ticker-label'>کل بازار</span><span class='ticker-value'>$2.4T</span><span class='ticker-change up'>+1.2%</span></div></div><div class='ticker-divider'></div><div class='ticker-item'><div class='ticker-icon' style='color:#f87171;background:rgba(248,113,113,0.1);border-color:rgba(248,113,113,0.2);'>&#9651;</div><div class='ticker-info'><span class='ticker-label'>حجم ۲۴ ساعت</span><span class='ticker-value'>$98.3B</span><span class='ticker-change dn'>-3.1%</span></div></div><div class='ticker-divider'></div><div class='ticker-item'><div class='ticker-icon' style='color:#34d399;background:rgba(52,211,153,0.1);border-color:rgba(52,211,153,0.2);'>&#9679;</div><div class='ticker-info'><span class='ticker-label'>دامیننس BTC</span><span class='ticker-value'>54.2%</span><span class='ticker-change up'>+0.3%</span></div></div></div>"
