              "widgetType": "html",
              "settings": {
                "html": "<style>.section-header{text-align:center;margin-bottom:60px;font-family:'Vazirmatn',Tahoma,Arial,sans-serif;direction:rtl;}.section-tag{display:inline-flex;align-items:center;gap:8px;background:rgba(247,148,29,0.08);border:1px solid rgba(247,148,29,0.2);border-radius:50px;padding:6px 18px;font-size:13px;color:#f7941d;font-weight:600;margin-bottom:16px;}.section-title{font-size:clamp(28px,4vw,44px);font-weight:900;color:#fff;margin:0 0 14px;}.section-title span{color:#f7941d;}.section-desc{font-size:15px;color:#666;max-width:540px;margin:0 auto;line-height:1.8;}.feat-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:24px;max-width:1100px;margin:0 auto;}.feat-card{background:#0f0f0f;border:1px solid rgba(255,255,255,0.06);border-radius:20px;padding:36px 28px;transition:all 0.4s;position:relative;overflow:hidden;}.feat-card::before{content:'';position:absolute;inset:0;background:linear-gradient(135deg,rgba(247,148,29,0.04),transparent);opacity:0;transition:opacity 0.4s;}.feat-card:hover{border-color:rgba(247,148,29,0.3);transform:translateY(-6px);box-shadow:0 20px 60px rgba(0,0,0,0.6);}.feat-card:hover::before{opacity:1;}.feat-icon{width:60px;height:60px;border-radius:16px;display:flex;align-items:center;justify-content:center;font-size:28px;margin-bottom:20px;}.feat-icon.orange{background:rgba(247,148,29,0.12);}.feat-icon.green{background:rgba(38,166,91,0.12);}.feat-icon.purple{background:rgba(139,92,246,0.12);}.feat-icon.blue{background:rgba(34,211,238,0.12);}.feat-name{font-size:20px;font-weight:700;color:#fff;margin-bottom:10px;direction:rtl;text-align:right;}.feat-text{font-size:14px;color:#666;line-height:1.8;direction:rtl;text-align:right;}.feat-link{display:inline-flex;align-items:center;gap:6px;color:#f7941d;font-size:13px;font-weight:600;text-decoration:none;margin-top:16px;transition:gap 0.3s;direction:rtl;}.feat-link:hover{gap:10px;}</style><div class='section-header'><div class='section-tag'>&#9670; خدم