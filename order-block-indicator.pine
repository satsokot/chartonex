//@version=5
const bool DEBUG = false
const int maxBoxesCount = 500
const float overlapThresholdPercentage = 0
const int maxDistanceToLastBar = 1750 // Affects Running Time
const int maxOrderBlocks = 30
const int maxLiqLevels = 10

indicator(title = 'اوردر بلاک + حجم (Flux & Mehdi)', overlay = true, max_boxes_count = maxBoxesCount, max_labels_count = maxBoxesCount, max_lines_count = maxBoxesCount, max_bars_back = 5000)

// ====================== Watermark Implementation ======================
var table waterMark = table.new(position.bottom_right, 1, 1, bgcolor = color.new(#d1ddd9, 53), border_width = 0)
if barstate.islast
    table.cell(waterMark, 0, 0, "instagram : forex_mehdi.pirhayati", text_color = color.new(#000000, 50), text_size = size.normal)
// ======================================================================

OBsEnabled = true
orderBlockVolumetricInfo = input.bool(true, "Volumetric Info", group = "General Configuration", inline="EV", display = display.none)
combineOBs = DEBUG ? input.bool(true, "Combine Zones", group = "General Configuration", display = display.none) : true
swingLength = input.int(10, 'OB Trigger Swing Length', minval = 3, tooltip="طول سوینگ موتور تشخیص اوردر بلاک", group = "General Configuration", display = display.none)
zoneCount = input.string("Low", 'Zone Count', options = ["High", "Medium", "Low", "One"], group = "General Configuration", display = display.none)

// ====================== رنگ‌ها ======================
bullOrderBlockColor = input(#57d71280, 'Bullish', inline = 'obColor', group = 'General Configuration', display = display.none)
bearOrderBlockColor = input(#e91e6380, 'Bearish', inline = 'obColor', group = 'General Configuration', display = display.none)

bullishOrderBlocks = zoneCount == "One" ? 1 : zoneCount == "Low" ? 3 : zoneCount == "Medium" ? 5 : 10
bearishOrderBlocks = zoneCount == "One" ? 1 : zoneCount == "Low" ? 3 : zoneCount == "Medium" ? 5 : 10

timeframe1Enabled = true
timeframe1 = ""

// ====================== رنگ و سایز متن ======================
textColor = input.color(#000000, "Text Color", group = "Style")
volumeTextColor = input.color(#000000, "Volume Text Color", group = "Style")
textSizeOption = input.string("Normal", "Text Size", options = ["Tiny", "Small", "Normal", "Large", "Huge"], group = "Style")
textSize = textSizeOption == "Tiny" ? size.tiny : textSizeOption == "Small" ? size.small : textSizeOption == "Normal" ? size.normal : textSizeOption == "Large" ? size.large : size.huge

extendZonesBy = 15
volumeBarsPlace = "Left"
mirrorVolumeBars = true
combinedText = false

volumeBarsLeftSide = (volumeBarsPlace == "Left")
extendZonesByTime = extendZonesBy * timeframe.in_seconds(timeframe.period) * 1000

// ====================== 1) Swing Structure ======================
intSwingLen = input.int(5, "Internal Swing Length", minval = 2, group = "ICT: Swing Structure")
extSwingLen = input.int(15, "External Swing Length", minval = 5, group = "ICT: Swing Structure")
useInternalStructure = input.bool(true, "Use Internal Structure", group = "ICT: Swing Structure")
useExternalStructure = input.bool(true, "Use External Structure", group = "ICT: Swing Structure")

// ====================== 2) BOS ======================
bosEnabled = input.bool(true, "Enable BOS Filter", group = "ICT: BOS")
bosSwingType = input.string("Both", "BOS Swing Type", options = ["Internal", "External", "Both"], group = "ICT: BOS")
bosConfirm = input.string("Close", "BOS Confirmation", options = ["Close", "Wick"], group = "ICT: BOS")
bosRequireDisp = input.bool(true, "Require Displacement on BOS", group = "ICT: BOS")
bosBodyATRMult = input.float(1.0, "Minimum BOS Body ATR Multiplier", minval = 0.1, step = 0.1, group = "ICT: BOS")
bosBodyPct = input.float(50, "Minimum BOS Candle Body %", minval = 0, maxval = 100, group = "ICT: BOS")

// ====================== 3) CHoCH / MSS ======================
chochEnabled = input.bool(true, "Enable CHOCH Filter", group = "ICT: CHOCH/MSS")
chochConfirm = input.string("Close", "CHOCH Confirmation", options = ["Close", "Wick"], group = "ICT: CHOCH/MSS")
chochRequireSweep = input.bool(true, "Require Sweep Before CHOCH", group = "ICT: CHOCH/MSS")
chochRequireDisp = input.bool(true, "Require Displacement After CHOCH", group = "ICT: CHOCH/MSS")
chochWindow = input.int(30, "CHOCH Validity Window (Bars)", minval = 5, group = "ICT: CHOCH/MSS")

// ====================== 4-5) BSL / SSL ======================
bslEnabled = input.bool(true, "Enable BSL Detection", group = "ICT: Liquidity (BSL/SSL)")
sslEnabled = input.bool(true, "Enable SSL Detection", group = "ICT: Liquidity (BSL/SSL)")
liqLookback = input.int(100, "BSL/SSL Lookback (Bars)", minval = 20, group = "ICT: Liquidity (BSL/SSL)")
eqTolType = input.string("ATR", "Equal High/Low Tolerance Type", options = ["ATR", "Ticks", "Percent"], group = "ICT: Liquidity (BSL/SSL)")
eqTolValue = input.float(0.25, "Equal High/Low Tolerance Value", minval = 0, step = 0.05, group = "ICT: Liquidity (BSL/SSL)")
showLiquidityLevels = input.bool(true, "Show BSL/SSL Levels", group = "ICT: Liquidity (BSL/SSL)")
usePDH = input.bool(true, "Use Previous Day High as BSL", group = "ICT: Liquidity (BSL/SSL)")
usePDL = input.bool(true, "Use Previous Day Low as SSL", group = "ICT: Liquidity (BSL/SSL)")

// ====================== 6) Sweep ======================
sweepEnabled = input.bool(true, "Enable Sweep Filter", group = "ICT: Sweep")
sweepConfirmMode = input.string("N-Bar Return", "Sweep Confirmation", options = ["Same Candle Close Back", "N-Bar Return"], group = "ICT: Sweep")
sweepReturnWindow = input.int(3, "Sweep Return Window (Bars)", minval = 1, group = "ICT: Sweep")

// ====================== 7) Premium / Discount ======================
pdEnabled = input.bool(true, "Enable Premium/Discount Filter", group = "ICT: Premium/Discount")
pdLookback = input.int(50, "Dealing Range Lookback", minval = 10, group = "ICT: Premium/Discount")
pdSource = input.string("External Swing", "Dealing Range Source", options = ["External Swing", "Recent Range", "Sweep Range"], group = "ICT: Premium/Discount")
pdMinInsidePct = input.float(50, "Min % of OB Inside Correct Zone", minval = 0, maxval = 100, group = "ICT: Premium/Discount")
showEquilibrium = input.bool(true, "Show Equilibrium Line", group = "ICT: Premium/Discount")
showPDBackground = input.bool(false, "Show Premium/Discount Background", group = "ICT: Premium/Discount")

// ====================== 8) FVG ======================
fvgEnabled = input.bool(true, "Enable FVG Filter", group = "ICT: FVG")
fvgMinSizeType = input.string("ATR", "FVG Minimum Size Type", options = ["ATR", "Ticks", "Percent"], group = "ICT: FVG")
fvgMinSizeValue = input.float(0.0, "FVG Minimum Size Value", minval = 0, step = 0.1, group = "ICT: FVG")
fvgRequireUnfilled = input.bool(true, "Reject OB if FVG Fully Filled", group = "ICT: FVG")
maxObFvgBars = input.int(10, "Max Distance Between OB and FVG (Bars)", minval = 1, group = "ICT: FVG")
showFVGBoxes = input.bool(true, "Show Related FVG", group = "ICT: FVG")
useFvgCE = input.bool(false, "Use Consequent Encroachment 50% Level", group = "ICT: FVG")

// ====================== 9) Displacement ======================
dispEnabled = input.bool(true, "Enable Displacement Filter", group = "ICT: Displacement")
dispATRLen = input.int(14, "ATR Length", minval = 1, group = "ICT: Displacement")
dispATRMult = input.float(1.2, "Minimum Body ATR Multiplier", minval = 0.1, step = 0.1, group = "ICT: Displacement")
dispMinBodyPct = input.float(50, "Minimum Candle Body %", minval = 0, maxval = 100, group = "ICT: Displacement")
dispNearExtreme = input.bool(false, "Close Near Extreme Required", group = "ICT: Displacement")
dispExtremePct = input.float(25, "Close Near Extreme %", minval = 5, maxval = 50, group = "ICT: Displacement")

// ====================== 10) OB Candidate ======================
obCandidateMode = input.string("Hybrid", "OB Candidate Mode", options = ["Last Opposite Candle", "Extreme Opposite Candle", "Hybrid"], group = "ICT: OB Candidate")
obSearchWindow = input.int(10, "OB Search Window Before Displacement", minval = 2, group = "ICT: OB Candidate")
maxATRMult = input.float(3.5, "Max OB Size ATR Multiplier", minval = 0.5, group = "ICT: OB Candidate")
useBodyOnly = input.bool(false, "Use Candle Body Only (No Wicks)", group = "ICT: OB Candidate")
requireCauseStructure = input.bool(true, "Require OB To Cause BOS/CHOCH", group = "ICT: OB Candidate")

// ====================== 12) Mitigation / Invalidation ======================
mitigationMethod = input.string("Wick", "Mitigation Method", options = ["Wick", "Close"], group = "Mitigation & Invalidation")
invalidationMethod = input.string("Wick", "Invalidation Method", options = ["Wick", "Close"], group = "Mitigation & Invalidation")
deleteOnMitigation = input.bool(true, "Delete On First Mitigation", group = "Mitigation & Invalidation")
maxMitigations = input.int(1, "Max Allowed Mitigations", minval = 1, group = "Mitigation & Invalidation")
deleteOnInvalidation = input.bool(true, "Delete On Invalidation", group = "Mitigation & Invalidation")
markMitigatedOB = input.bool(true, "Mark Mitigated OB", group = "Mitigation & Invalidation")
markWeakOB = input.bool(true, "Mark Weak OB (More Transparent)", group = "Mitigation & Invalidation")

// ====================== 13) Mean Threshold ======================
showMeanLine = input.bool(true, "Show Mean Threshold Line", group = "ICT: Mean Threshold")
meanMode = input.string("Display Only", "Mean Threshold Mode", options = ["Display Only", "Mark Weak", "Invalidate"], group = "ICT: Mean Threshold")
meanLineStyle = input.string("Dotted", "Mean Threshold Line Style", options = ["Dotted", "Dashed", "Solid"], group = "ICT: Mean Threshold")

// ====================== 14) Volume / Absorption ======================
absEnabled = input.bool(false, "Enable Absorption Filter", group = "ICT: Volume Absorption")
absVolSMAMult = input.float(1.0, "Min Total Volume vs SMA Volume", minval = 0, step = 0.1, group = "ICT: Volume Absorption")
absMinOppPct = input.float(40, "Min Opposite Side Volume %", minval = 0, maxval = 100, group = "ICT: Volume Absorption")
volSMALen = input.int(20, "Volume SMA Length", minval = 1, group = "ICT: Volume Absorption")
showVolInText = input.bool(true, "Show Volume Tags In OB Text", group = "ICT: Volume Absorption")

// ====================== 15) Quality Score ======================
minScore = input.int(8, "Minimum Score To Display (0-15)", minval = 0, maxval = 15, group = "ICT: Quality Score")
showScore = input.bool(true, "Show Score In OB Text", group = "ICT: Quality Score")
showTags = input.bool(true, "Show Validation Tags", group = "ICT: Quality Score")
hideBelowScore = input.bool(true, "Hide OBs Below Minimum Score", tooltip = "اگر خاموش باشد، اوردر بلاک کم‌امتیاز به‌جای حذف، کم‌رنگ نمایش داده می‌شود", group = "ICT: Quality Score")

// ====================== Structure Drawings ======================
showStructure = input.bool(true, "Show BOS / CHoCH (MSS) Lines", group = "ICT: Structure Drawings")
structLabelColor = input.color(color.white, "Structure Label Color", group = "ICT: Structure Drawings")
maxStructDrawings = input.int(15, "Max Drawings Per Type", minval = 3, maxval = 50, group = "ICT: Structure Drawings")

atr = ta.atr(10)

// ====================== منبع دیتای حجم — روش Footprint IQ Pro ======================
// مهم: Pine به bid/ask واقعی تاریخی دسترسی ندارد. حجم خرید/فروش «تخمینی» است:
// از جهت کندل‌های تایم‌فریم پایین‌تر (اینترابار) با request.security_lower_tf محاسبه می‌شود.
footprintGranularity = input.string("1-Minute", "Granularity (Footprint)", options = ["Auto", "1-Minute", "1-Second"], group = "Volume Data", tooltip = "دقت خواندن دیتای داخل کندل. 1-Second نیازمند پلن Premium است.")

lowerTfStr = footprintGranularity == "1-Second" ? "1S" : footprintGranularity == "1-Minute" ? "1" : timeframe.in_seconds() >= 86400 ? "30" : timeframe.in_seconds() >= 3600 ? "5" : "1"

ltfBuyArr = request.security_lower_tf(syminfo.tickerid, lowerTfStr, close > open ? nz(volume) : close < open ? 0.0 : close >= nz(close[1], close) ? nz(volume) : 0.0)
ltfSellArr = request.security_lower_tf(syminfo.tickerid, lowerTfStr, close < open ? nz(volume) : close > open ? 0.0 : close < nz(close[1], close) ? nz(volume) : 0.0)
ltfBuyTicks = request.security_lower_tf(syminfo.tickerid, lowerTfStr, close > open ? 1.0 : close < open ? 0.0 : close >= nz(close[1], close) ? 1.0 : 0.0)
ltfSellTicks = request.security_lower_tf(syminfo.tickerid, lowerTfStr, close < open ? 1.0 : close > open ? 0.0 : close < nz(close[1], close) ? 1.0 : 0.0)

intrabarBuy = ltfBuyArr.size() > 0 ? nz(ltfBuyArr.sum()) : 0.0
intrabarSell = ltfSellArr.size() > 0 ? nz(ltfSellArr.sum()) : 0.0
hasIntrabarData = (intrabarBuy + intrabarSell) > 0

tickBuy = ltfBuyTicks.size() > 0 ? nz(ltfBuyTicks.sum()) : 0.0
tickSell = ltfSellTicks.size() > 0 ? nz(ltfSellTicks.sum()) : 0.0
hasTickData = (tickBuy + tickSell) > 0

estimateRatio = (high - low) > 0 ? (close - low) / (high - low) : 0.5
baseVolume = nz(volume) > 0 ? nz(volume) : (high - low) / syminfo.mintick
estimateBuy = baseVolume * estimateRatio
estimateSell = baseVolume - estimateBuy

// 1) حجم واقعی اینترابار  2) تیک-والیوم  3) تخمین از بازه کندل
barBuyVolume = hasIntrabarData ? intrabarBuy : hasTickData ? tickBuy : estimateBuy
barSellVolume = hasIntrabarData ? intrabarSell : hasTickData ? tickSell : estimateSell
// ====================================================================================

// ====================== سری‌های سراسری ICT (فقط دیتای گذشته — بدون ریپینت) ======================
atrDisp = ta.atr(dispATRLen)
totalBarVolume = barBuyVolume + barSellVolume
volSMA = ta.sma(totalBarVolume, volSMALen)

// --- Displacement ---
dispBody = math.abs(close - open)
candleRangeSize = high - low
nearHighOK = not dispNearExtreme or (candleRangeSize <= 0 or (high - close) <= candleRangeSize * dispExtremePct / 100)
nearLowOK = not dispNearExtreme or (candleRangeSize <= 0 or (close - low) <= candleRangeSize * dispExtremePct / 100)
bullDisplacement = close > open and dispBody >= atrDisp * dispATRMult and (candleRangeSize <= 0 or dispBody >= candleRangeSize * dispMinBodyPct / 100) and nearHighOK
bearDisplacement = close < open and dispBody >= atrDisp * dispATRMult and (candleRangeSize <= 0 or dispBody >= candleRangeSize * dispMinBodyPct / 100) and nearLowOK
// بدنه قوی مخصوص BOS
bosBodyOK = dispBody >= atrDisp * bosBodyATRMult and (candleRangeSize <= 0 or dispBody >= candleRangeSize * bosBodyPct / 100)

// --- پیوت‌های داخلی و خارجی ---
intPH = ta.pivothigh(high, intSwingLen, intSwingLen)
intPL = ta.pivotlow(low, intSwingLen, intSwingLen)
extPH = ta.pivothigh(high, extSwingLen, extSwingLen)
extPL = ta.pivotlow(low, extSwingLen, extSwingLen)

// --- تلورانس Equal High/Low و حداقل سایز FVG ---
tolAmount (tType, tVal) =>
    tType == "ATR" ? atrDisp * tVal : tType == "Ticks" ? syminfo.mintick * tVal : close * tVal / 100

eqTol = tolAmount(eqTolType, eqTolValue)
fvgMinSize = tolAmount(fvgMinSizeType, fvgMinSizeValue)

// --- FVG سه‌کندلی کلاسیک ---
bullFVGRaw = low > high[2] and (low - high[2]) >= fvgMinSize
bearFVGRaw = high < low[2] and (low[2] - high) >= fvgMinSize

// --- PDH / PDL (بدون ریپینت: کندل بسته روز قبل) ---
[pdhVal, pdlVal] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)
newDay = ta.change(time("D")) != 0

// --- رنج معاملاتی fallback ---
rangeHigh = ta.highest(high, pdLookback)
rangeLow = ta.lowest(low, pdLookback)
// ====================================================================================

// ====================== استیت سراسری ساختار بازار ======================
var float lastIntHigh = na, var bool intHighBroken = true, var int lastIntHighBar = na
var float lastIntLow = na, var bool intLowBroken = true, var int lastIntLowBar = na
var float lastExtHigh = na, var bool extHighBroken = true, var int lastExtHighBar = na
var float lastExtLow = na, var bool extLowBroken = true, var int lastExtLowBar = na
var int marketDir = 0 // 1 صعودی، -1 نزولی
var int lastBullBOSBar = na, var int lastBearBOSBar = na
var int lastBullChochBar = na, var int lastBearChochBar = na
var int lastBullSweepBar = na, var int lastBearSweepBar = na // SSL sweep → صعودی، BSL sweep → نزولی
var float lastSweptSSL = na, var float lastSweptBSL = na
var int lastBullDispBar = na, var int lastBearDispBar = na
var float bullFVGTop = na, var float bullFVGBtm = na, var int lastBullFVGBar = na, var bool bullFVGFilled = true
var float bearFVGTop = na, var float bearFVGBtm = na, var int lastBearFVGBar = na, var bool bearFVGFilled = true

// --- آرایه‌های سطوح نقدینگی: state: 0=فعال، 1=در انتظار برگشت ---
var float[] bslPrices = array.new<float>(0)
var int[] bslStates = array.new<int>(0)
var int[] bslPendingBars = array.new<int>(0)
var int[] bslBornBars = array.new<int>(0)
var line[] bslLines = array.new<line>(0)
var label[] bslLabels = array.new<label>(0)

var float[] sslPrices = array.new<float>(0)
var int[] sslStates = array.new<int>(0)
var int[] sslPendingBars = array.new<int>(0)
var int[] sslBornBars = array.new<int>(0)
var line[] sslLines = array.new<line>(0)
var label[] sslLabels = array.new<label>(0)

// --- آرایه‌های رسم ---
var line[] structLines = array.new<line>(0)
var label[] structLabels = array.new<label>(0)
var line[] sweptLines = array.new<line>(0)
var label[] sweptLabels = array.new<label>(0)
var box[] fvgBoxes = array.new<box>(0)
var line[] fvgCELines = array.new<line>(0)

pushLineCapped (line[] arr, line l, int maxCount) =>
    arr.push(l)
    if arr.size() > maxCount
        line.delete(arr.shift())

pushLabelCapped (label[] arr, label l, int maxCount) =>
    arr.push(l)
    if arr.size() > maxCount
        label.delete(arr.shift())

pushBoxCapped (box[] arr, box b, int maxCount) =>
    arr.push(b)
    if arr.size() > maxCount
        box.delete(arr.shift())
// ====================================================================================

type orderBlockInfo
    float top
    float bottom
    float obVolume
    string obType
    int startTime
    float bbVolume
    float obLowVolume
    float obHighVolume
    bool breaker
    int breakTime
    string timeframeStr
    bool disabled = false
    string combinedTimeframesStr = na
    bool combined = false
    float meanThreshold = na
    int mitigationCount = 0
    bool inZone = false
    int score = 0
    string tags = ""
    bool weak = false

type orderBlock
    orderBlockInfo info
    bool isRendered = false

    box orderBox = na
    box breakerBox = na

    line orderBoxLineTop = na
    line orderBoxLineBottom = na
    line breakerBoxLineTop = na
    line breakerBoxLineBottom = na
    line meanLine = na
    //
    box orderBoxText = na
    box orderBoxPositive = na
    box orderBoxNegative = na

    line orderSeperator = na
    line orderTextSeperator = na

createOrderBlock (orderBlockInfo orderBlockInfoF) =>
    orderBlock newOrderBlock = orderBlock.new(orderBlockInfoF)
    newOrderBlock

safeDeleteOrderBlock (orderBlock orderBlockF) =>
    orderBlockF.isRendered := false

    box.delete(orderBlockF.orderBox)
    box.delete(orderBlockF.breakerBox)
    box.delete(orderBlockF.orderBoxText)
    box.delete(orderBlockF.orderBoxPositive)
    box.delete(orderBlockF.orderBoxNegative)

    line.delete(orderBlockF.orderBoxLineTop)
    line.delete(orderBlockF.orderBoxLineBottom)
    line.delete(orderBlockF.breakerBoxLineTop)
    line.delete(orderBlockF.breakerBoxLineBottom)
    line.delete(orderBlockF.meanLine)
    line.delete(orderBlockF.orderSeperator)
    line.delete(orderBlockF.orderTextSeperator)

type timeframeInfo
    int index = na
    string timeframeStr = na
    bool isEnabled = false

    orderBlockInfo[] bullishOrderBlocksList = na
    orderBlockInfo[] bearishOrderBlocksList = na

newTimeframeInfo (index, timeframeStr, isEnabled) =>
    newTFInfo = timeframeInfo.new()
    newTFInfo.index := index
    newTFInfo.isEnabled := isEnabled
    newTFInfo.timeframeStr := timeframeStr

    newTFInfo

type obSwing
    int x = na
    float y = na
    float swingVolume = na
    bool crossed = false

// ____ TYPES END ____

var timeframeInfo[] timeframeInfos = array.from(newTimeframeInfo(1, timeframe1, timeframe1Enabled))
var bullishOrderBlocksList = array.new<orderBlockInfo>(0)
var bearishOrderBlocksList = array.new<orderBlockInfo>(0)

var allOrderBlocksList = array.new<orderBlock>(0)

moveLine(_line, _x, _y, _x2) =>
    line.set_xy1(_line, _x, _y)
    line.set_xy2(_line, _x2, _y)

moveBox (_box, _topLeftX, _topLeftY, _bottomRightX, _bottomRightY) =>
    box.set_lefttop(_box, _topLeftX, _topLeftY)
    box.set_rightbottom(_box, _bottomRightX, _bottomRightY)

isTimeframeLower (timeframe1F, timeframe2F) =>
    timeframe.in_seconds(timeframe1F) < timeframe.in_seconds(timeframe2F)

formatTimeframeString (formatTimeframe) =>
    timeframeF = formatTimeframe == "" ? timeframe.period : formatTimeframe

    if str.contains(timeframeF, "D") or str.contains(timeframeF, "W") or str.contains(timeframeF, "S") or str.contains(timeframeF, "M")
        timeframeF
    else
        seconds = timeframe.in_seconds(timeframeF)
        if seconds >= 3600
            hourCount = int(seconds / 3600)
            str.tostring(hourCount) + " Hour" + (hourCount > 1 ? "s" : "")
        else
            timeframeF + " Min"

colorWithTransparency (colorF, transparencyX) =>
    color.new(colorF, math.min(color.t(colorF) * transparencyX, 100))

createOBBox (boxColor, transparencyX = 1.0, xlocType = xloc.bar_time) =>
    box.new(na, na, na, na, text_size = textSize, xloc = xlocType, extend = extend.none, bgcolor = colorWithTransparency(boxColor, transparencyX), text_color = textColor, text_halign = text.align_center, border_color = #00000000)

renderOrderBlock (orderBlock ob) =>
    orderBlockInfo info = ob.info
    ob.isRendered := true
    orderColor = ob.info.obType == "Bull" ? bullOrderBlockColor : bearOrderBlockColor
    mainTransparency = info.weak and markWeakOB ? 2.5 : 1.5

    if OBsEnabled
        ob.orderBox := createOBBox(orderColor, mainTransparency)
        if ob.info.combined
            ob.orderBox.set_bgcolor(colorWithTransparency(orderColor, info.weak and markWeakOB ? 2.2 : 1.1))
        ob.orderBoxText := createOBBox(color.new(color.white, 100))
        if orderBlockVolumetricInfo
            ob.orderBoxPositive := createOBBox(bullOrderBlockColor)
            ob.orderBoxNegative := createOBBox(bearOrderBlockColor)
            ob.orderSeperator := line.new(na,na,na,na,xloc.bar_time,extend.none,textColor,line.style_dashed,1)
            ob.orderTextSeperator := line.new(na,na,na,na,xloc.bar_time,extend.none,textColor,line.style_solid,1)

        // باکس از محل تشکیل تا کندل جاری؛ حداقل عرض برای جا شدن متن تضمین می‌شود
        zoneSize = math.max((time + 1) - info.startTime, extendZonesByTime)

        startX = volumeBarsLeftSide ? info.startTime : info.startTime + zoneSize - zoneSize / 3
        maxEndX = volumeBarsLeftSide ? info.startTime + zoneSize / 3 : info.startTime + zoneSize

        moveBox(ob.orderBox, info.startTime, info.top, info.startTime + zoneSize, info.bottom)
        moveBox(ob.orderBoxText, volumeBarsLeftSide ? maxEndX : info.startTime, info.top, volumeBarsLeftSide ? info.startTime + zoneSize : startX, info.bottom)

        // خط Mean Threshold (سطح 50% اوردر بلاک)
        if showMeanLine and not na(info.meanThreshold)
            meanStyle = meanLineStyle == "Dotted" ? line.style_dotted : meanLineStyle == "Dashed" ? line.style_dashed : line.style_solid
            ob.meanLine := line.new(info.startTime, info.meanThreshold, info.startTime + zoneSize, info.meanThreshold, xloc.bar_time, extend.none, textColor, meanStyle, 1)

        buyVolume = nz(info.obHighVolume)
        sellVolume = nz(info.obLowVolume)
        totalVolume = buyVolume + sellVolume
        delta = buyVolume - sellVolume
        deltaText = (delta >= 0 ? "+" : "") + str.tostring(delta, format.volume)

        percentage = totalVolume > 0 ? int((math.min(buyVolume, sellVolume) / math.max(math.max(buyVolume, sellVolume), 1)) * 100.0) : 0

        buyShare = totalVolume > 0 ? buyVolume / totalVolume : 0.5
        sellShare = totalVolume > 0 ? sellVolume / totalVolume : 0.5
        buyTransparency = int(100 - buyShare * 100)
        sellTransparency = int(100 - sellShare * 100)

        persianText = ob.info.obType == "Bull" ? "ناحیه مناسب خرید" : "ناحیه مناسب فروش"
        timeframeLabel = na(ob.info.combinedTimeframesStr) ? formatTimeframeString(ob.info.timeframeStr) : ob.info.combinedTimeframesStr

        volumePart = orderBlockVolumetricInfo and showVolInText ? str.tostring(nz(ob.info.obVolume), format.volume) + " (" + str.tostring(percentage) + "%)\n" : ""
        deltaPart = orderBlockVolumetricInfo and showVolInText ? "دلتا: " + deltaText + "\n" : ""
        scorePart = showScore ? "امتیاز: " + str.tostring(info.score) + "/15\n" : ""
        tagsPart = showTags and str.length(info.tags) > 0 ? info.tags + "\n" : ""
        combinedPart = (combinedText and ob.info.combined) ? "[Combined]\n" : ""

        finalText = volumePart + deltaPart + scorePart + persianText + "\n" + timeframeLabel + "\n" + tagsPart + combinedPart
        box.set_text(ob.orderBoxText, finalText)

        if orderBlockVolumetricInfo
            curEndXHigh = int(math.ceil(buyShare * (maxEndX - startX) + startX))
            curEndXLow = int(math.ceil(sellShare * (maxEndX - startX) + startX))

            moveBox(ob.orderBoxPositive, mirrorVolumeBars ? startX : curEndXLow, info.top, mirrorVolumeBars ? curEndXHigh : maxEndX, (info.bottom + info.top) / 2)
            box.set_text(ob.orderBoxPositive, "خرید: " + str.tostring(buyVolume, format.volume))
            box.set_text_color(ob.orderBoxPositive, volumeTextColor)
            box.set_bgcolor(ob.orderBoxPositive, color.new(bullOrderBlockColor, buyTransparency))

            moveBox(ob.orderBoxNegative, mirrorVolumeBars ? startX : curEndXHigh, info.bottom, mirrorVolumeBars ? curEndXLow : maxEndX, (info.bottom + info.top) / 2)
            box.set_text(ob.orderBoxNegative, "فروش: " + str.tostring(sellVolume, format.volume))
            box.set_text_color(ob.orderBoxNegative, volumeTextColor)
            box.set_bgcolor(ob.orderBoxNegative, color.new(bearOrderBlockColor, sellTransparency))

            moveLine(ob.orderSeperator, volumeBarsLeftSide ? startX : maxEndX, (info.bottom + info.top) / 2, volumeBarsLeftSide ? maxEndX : startX)

            line.set_xy1(ob.orderTextSeperator, volumeBarsLeftSide ? maxEndX : startX, info.top)
            line.set_xy2(ob.orderTextSeperator, volumeBarsLeftSide ? maxEndX : startX, info.bottom)

findOBSwings(len) =>
    var swingType = 0
    var obSwing top = obSwing.new(na, na)
    var obSwing bottom = obSwing.new(na, na)

    upper = ta.highest(len)
    lower = ta.lowest(len)

    swingType := high[len] > upper ? 0 : low[len] < lower ? 1 : swingType

    if swingType == 0 and swingType[1] != 0
        top := obSwing.new(bar_index[len], high[len], volume[len])

    if swingType == 1 and swingType[1] != 1
        bottom := obSwing.new(bar_index[len], low[len], volume[len])

    [top, bottom]

// حجم خریدار/فروشنده یک کندل — تخمینی از دیتای اینترابار (نه bid/ask واقعی)
candleBuyVolume (i) =>
    nz(barBuyVolume[i])

candleSellVolume (i) =>
    nz(barSellVolume[i])

buildTags (sweepOK, chochOK, bosOK, dispOK, fvgOK, pdOK, absOK, isBull) =>
    string tags = ""
    if showTags
        tags += sweepOK ? "Sweep ✓ " : ""
        tags += chochOK ? "CHOCH ✓ " : ""
        tags += bosOK ? "BOS ✓ " : ""
        tags += dispOK ? "Displacement ✓ " : ""
        tags += fvgOK ? "FVG ✓ " : ""
        tags += pdOK ? (isBull ? "Discount ✓ " : "Premium ✓ ") : ""
        tags += absOK ? "Absorption ✓" : ""
    tags

// ====================== موتور نقدینگی، سوییپ و ساختار (اسکوپ سراسری) ======================
// نکته: هیچ‌کدام از این رسم‌ها نباید داخل findOrderBlocks باشد (محدودیت security)

// --- ثبت سطوح نقدینگی جدید از پیوت‌های خارجی + Equal High/Low ---
if barstate.isconfirmed and bslEnabled and not na(extPH)
    merged = false
    if bslPrices.size() > 0
        for i = 0 to bslPrices.size() - 1
            if bslStates.get(i) == 0 and math.abs(bslPrices.get(i) - extPH) <= eqTol
                bslPrices.set(i, math.max(bslPrices.get(i), extPH)) // Equal Highs → یک سطح
                merged := true
    if not merged
        bslPrices.push(extPH)
        bslStates.push(0)
        bslPendingBars.push(0)
        bslBornBars.push(bar_index - extSwingLen)
        bslLines.push(showLiquidityLevels ? line.new(bar_index - extSwingLen, extPH, bar_index, extPH, xloc.bar_index, extend.none, bearOrderBlockColor, line.style_dashed, 1) : line(na))
        bslLabels.push(showLiquidityLevels ? label.new(bar_index, extPH, "BSL", xloc.bar_index, yloc.price, #00000000, label.style_label_left, structLabelColor, size.small) : label(na))
        if bslPrices.size() > maxLiqLevels
            bslPrices.shift(), bslStates.shift(), bslPendingBars.shift(), bslBornBars.shift()
            line.delete(bslLines.shift()), label.delete(bslLabels.shift())

if barstate.isconfirmed and sslEnabled and not na(extPL)
    merged = false
    if sslPrices.size() > 0
        for i = 0 to sslPrices.size() - 1
            if sslStates.get(i) == 0 and math.abs(sslPrices.get(i) - extPL) <= eqTol
                sslPrices.set(i, math.min(sslPrices.get(i), extPL)) // Equal Lows → یک سطح
                merged := true
    if not merged
        sslPrices.push(extPL)
        sslStates.push(0)
        sslPendingBars.push(0)
        sslBornBars.push(bar_index - extSwingLen)
        sslLines.push(showLiquidityLevels ? line.new(bar_index - extSwingLen, extPL, bar_index, extPL, xloc.bar_index, extend.none, bullOrderBlockColor, line.style_dashed, 1) : line(na))
        sslLabels.push(showLiquidityLevels ? label.new(bar_index, extPL, "SSL", xloc.bar_index, yloc.price, #00000000, label.style_label_left, structLabelColor, size.small) : label(na))
        if sslPrices.size() > maxLiqLevels
            sslPrices.shift(), sslStates.shift(), sslPendingBars.shift(), sslBornBars.shift()
            line.delete(sslLines.shift()), label.delete(sslLabels.shift())

// --- PDH / PDL به‌عنوان نقدینگی روزانه ---
if barstate.isconfirmed and usePDH and newDay and not na(pdhVal)
    bslPrices.push(pdhVal), bslStates.push(0), bslPendingBars.push(0), bslBornBars.push(bar_index)
    bslLines.push(showLiquidityLevels ? line.new(bar_index, pdhVal, bar_index + 1, pdhVal, xloc.bar_index, extend.none, bearOrderBlockColor, line.style_dotted, 1) : line(na))
    bslLabels.push(showLiquidityLevels ? label.new(bar_index + 1, pdhVal, "PDH", xloc.bar_index, yloc.price, #00000000, label.style_label_left, structLabelColor, size.small) : label(na))
    if bslPrices.size() > maxLiqLevels
        bslPrices.shift(), bslStates.shift(), bslPendingBars.shift(), bslBornBars.shift()
        line.delete(bslLines.shift()), label.delete(bslLabels.shift())

if barstate.isconfirmed and usePDL and newDay and not na(pdlVal)
    sslPrices.push(pdlVal), sslStates.push(0), sslPendingBars.push(0), sslBornBars.push(bar_index)
    sslLines.push(showLiquidityLevels ? line.new(bar_index, pdlVal, bar_index + 1, pdlVal, xloc.bar_index, extend.none, bullOrderBlockColor, line.style_dotted, 1) : line(na))
    sslLabels.push(showLiquidityLevels ? label.new(bar_index + 1, pdlVal, "PDL", xloc.bar_index, yloc.price, #00000000, label.style_label_left, structLabelColor, size.small) : label(na))
    if sslPrices.size() > maxLiqLevels
        sslPrices.shift(), sslStates.shift(), sslPendingBars.shift(), sslBornBars.shift()
        line.delete(sslLines.shift()), label.delete(sslLabels.shift())

// --- پردازش سوییپ BSL: ویک بالای سطح + برگشت کلوز زیر آن = سوییپ؛ ادامه صعود = شکست (BOS)، نه سوییپ ---
if barstate.isconfirmed and bslPrices.size() > 0
    for i = bslPrices.size() - 1 to 0
        lvl = bslPrices.get(i)
        st = bslStates.get(i)
        removeIt = false
        swept = false

        // سطح خیلی قدیمی حذف می‌شود
        if bar_index - bslBornBars.get(i) > liqLookback
            removeIt := true

        if not removeIt and st == 0 and high > lvl
            if close < lvl
                swept := true
                removeIt := true
            else if sweepConfirmMode == "N-Bar Return"
                bslStates.set(i, 1)
                bslPendingBars.set(i, bar_index)
            else
                removeIt := true // کلوز قوی بالای سطح = شکست، سوییپ نیست

        if not removeIt and bslStates.get(i) == 1
            if close < lvl
                swept := true
                removeIt := true
            else if bar_index - bslPendingBars.get(i) > sweepReturnWindow
                removeIt := true // برنگشت → شکست

        if not removeIt and bslStates.get(i) == 0 and showLiquidityLevels
            line.set_x2(bslLines.get(i), bar_index)
            label.set_x(bslLabels.get(i), bar_index)

        if removeIt
            oldLine = bslLines.get(i)
            oldLabel = bslLabels.get(i)
            if swept
                lastBearSweepBar := bar_index
                lastSweptBSL := lvl
                if showLiquidityLevels
                    line.set_x2(oldLine, bar_index)
                    label.set_text(oldLabel, "BSL Sweep ✗")
                    label.set_x(oldLabel, bar_index)
                    pushLineCapped(sweptLines, oldLine, maxStructDrawings)
                    pushLabelCapped(sweptLabels, oldLabel, maxStructDrawings)
                else
                    line.delete(oldLine), label.delete(oldLabel)
            else
                line.delete(oldLine), label.delete(oldLabel)
            bslPrices.remove(i), bslStates.remove(i), bslPendingBars.remove(i), bslBornBars.remove(i)
            bslLines.remove(i), bslLabels.remove(i)

// --- پردازش سوییپ SSL ---
if barstate.isconfirmed and sslPrices.size() > 0
    for i = sslPrices.size() - 1 to 0
        lvl = sslPrices.get(i)
        st = sslStates.get(i)
        removeIt = false
        swept = false

        if bar_index - sslBornBars.get(i) > liqLookback
            removeIt := true

        if not removeIt and st == 0 and low < lvl
            if close > lvl
                swept := true
                removeIt := true
            else if sweepConfirmMode == "N-Bar Return"
                sslStates.set(i, 1)
                sslPendingBars.set(i, bar_index)
            else
                removeIt := true

        if not removeIt and sslStates.get(i) == 1
            if close > lvl
                swept := true
                removeIt := true
            else if bar_index - sslPendingBars.get(i) > sweepReturnWindow
                removeIt := true

        if not removeIt and sslStates.get(i) == 0 and showLiquidityLevels
            line.set_x2(sslLines.get(i), bar_index)
            label.set_x(sslLabels.get(i), bar_index)

        if removeIt
            oldLine = sslLines.get(i)
            oldLabel = sslLabels.get(i)
            if swept
                lastBullSweepBar := bar_index
                lastSweptSSL := lvl
                if showLiquidityLevels
                    line.set_x2(oldLine, bar_index)
                    label.set_text(oldLabel, "SSL Sweep ✗")
                    label.set_x(oldLabel, bar_index)
                    pushLineCapped(sweptLines, oldLine, maxStructDrawings)
                    pushLabelCapped(sweptLabels, oldLabel, maxStructDrawings)
                else
                    line.delete(oldLine), label.delete(oldLabel)
            else
                line.delete(oldLine), label.delete(oldLabel)
            sslPrices.remove(i), sslStates.remove(i), sslPendingBars.remove(i), sslBornBars.remove(i)
            sslLines.remove(i), sslLabels.remove(i)

// --- به‌روزرسانی پیوت‌های ساختاری (سطوح نشکسته) ---
if barstate.isconfirmed
    if not na(intPH)
        lastIntHigh := intPH, lastIntHighBar := bar_index - intSwingLen, intHighBroken := false
    if not na(intPL)
        lastIntLow := intPL, lastIntLowBar := bar_index - intSwingLen, intLowBroken := false
    if not na(extPH)
        lastExtHigh := extPH, lastExtHighBar := bar_index - extSwingLen, extHighBroken := false
    if not na(extPL)
        lastExtLow := extPL, lastExtLowBar := bar_index - extSwingLen, extLowBroken := false

// --- ثبت دیسپلیسمنت ---
if barstate.isconfirmed
    if bullDisplacement
        lastBullDispBar := bar_index
    if bearDisplacement
        lastBearDispBar := bar_index

// --- ردیابی FVG و وضعیت پر شدن آن ---
if barstate.isconfirmed
    if bullFVGRaw
        bullFVGTop := low, bullFVGBtm := high[2], lastBullFVGBar := bar_index, bullFVGFilled := false
        if showFVGBoxes
            pushBoxCapped(fvgBoxes, box.new(bar_index - 2, low, bar_index + 4, high[2], xloc = xloc.bar_index, border_color = #00000000, bgcolor = color.new(bullOrderBlockColor, 85), text = "FVG", text_color = structLabelColor, text_size = size.tiny, text_halign = text.align_right), maxStructDrawings)
            if useFvgCE
                pushLineCapped(fvgCELines, line.new(bar_index - 2, (low + high[2]) / 2, bar_index + 4, (low + high[2]) / 2, xloc.bar_index, extend.none, structLabelColor, line.style_dotted, 1), maxStructDrawings)
    if bearFVGRaw
        bearFVGTop := low[2], bearFVGBtm := high, lastBearFVGBar := bar_index, bearFVGFilled := false
        if showFVGBoxes
            pushBoxCapped(fvgBoxes, box.new(bar_index - 2, low[2], bar_index + 4, high, xloc = xloc.bar_index, border_color = #00000000, bgcolor = color.new(bearOrderBlockColor, 85), text = "FVG", text_color = structLabelColor, text_size = size.tiny, text_halign = text.align_right), maxStructDrawings)
            if useFvgCE
                pushLineCapped(fvgCELines, line.new(bar_index - 2, (low[2] + high) / 2, bar_index + 4, (low[2] + high) / 2, xloc.bar_index, extend.none, structLabelColor, line.style_dotted, 1), maxStructDrawings)
    // FVG صعودی وقتی کامل پر می‌شود که قیمت به زیر کف گپ برسد
    if not na(lastBullFVGBar) and not bullFVGFilled and low <= bullFVGBtm
        bullFVGFilled := true
    if not na(lastBearFVGBar) and not bearFVGFilled and high >= bearFVGTop
        bearFVGFilled := true

// --- ماشین حالت BOS / CHoCH ---
// BOS = شکست در جهت ساختار؛ CHoCH/MSS = شکست خلاف جهت (ترجیحاً بعد از سوییپ)
if barstate.isconfirmed
    bullBreakSrc = bosConfirm == "Close" ? close : high
    bearBreakSrc = bosConfirm == "Close" ? close : low
    chochBullSrc = chochConfirm == "Close" ? close : high
    chochBearSrc = chochConfirm == "Close" ? close : low

    // --- شکست سقف خارجی (فقط سطح نشکسته) ---
    extBullBreak = useExternalStructure and not extHighBroken and not na(lastExtHigh) and bullBreakSrc > lastExtHigh
    if extBullBreak
        extHighBroken := true
        bosDispOK = not bosRequireDisp or (close > open and bosBodyOK)
        if marketDir <= 0
            // خلاف جهت → CHoCH (MSS)
            sweepPre = not chochRequireSweep or (not na(lastBullSweepBar) and bar_index - lastBullSweepBar <= chochWindow)
            dispPost = not chochRequireDisp or bullDisplacement or bullDisplacement[1]
            if sweepPre and dispPost
                marketDir := 1
                lastBullChochBar := bar_index
                if showStructure
                    pushLineCapped(structLines, line.new(lastExtHighBar, lastExtHigh, bar_index, lastExtHigh, xloc.bar_index, extend.none, bullOrderBlockColor, line.style_solid, 1), maxStructDrawings)
                    pushLabelCapped(structLabels, label.new(bar_index, lastExtHigh, "CHoCH (MSS)", xloc.bar_index, yloc.price, #00000000, label.style_label_down, structLabelColor, size.small), maxStructDrawings)
        else if bosSwingType != "Internal" and bosDispOK
            // در جهت ساختار → BOS
            marketDir := 1
            lastBullBOSBar := bar_index
            if showStructure
                pushLineCapped(structLines, line.new(lastExtHighBar, lastExtHigh, bar_index, lastExtHigh, xloc.bar_index, extend.none, bullOrderBlockColor, line.style_solid, 1), maxStructDrawings)
                pushLabelCapped(structLabels, label.new(bar_index, lastExtHigh, "BOS", xloc.bar_index, yloc.price, #00000000, label.style_label_down, structLabelColor, size.small), maxStructDrawings)

    // --- شکست کف خارجی ---
    extBearBreak = useExternalStructure and not extLowBroken and not na(lastExtLow) and bearBreakSrc < lastExtLow
    if extBearBreak
        extLowBroken := true
        bosDispOK = not bosRequireDisp or (close < open and bosBodyOK)
        if marketDir >= 0
            sweepPre = not chochRequireSweep or (not na(lastBearSweepBar) and bar_index - lastBearSweepBar <= chochWindow)
            dispPost = not chochRequireDisp or bearDisplacement or bearDisplacement[1]
            if sweepPre and dispPost
                marketDir := -1
                lastBearChochBar := bar_index
                if showStructure
                    pushLineCapped(structLines, line.new(lastExtLowBar, lastExtLow, bar_index, lastExtLow, xloc.bar_index, extend.none, bearOrderBlockColor, line.style_solid, 1), maxStructDrawings)
                    pushLabelCapped(structLabels, label.new(bar_index, lastExtLow, "CHoCH (MSS)", xloc.bar_index, yloc.price, #00000000, label.style_label_up, structLabelColor, size.small), maxStructDrawings)
        else if bosSwingType != "Internal" and bosDispOK
            marketDir := -1
            lastBearBOSBar := bar_index
            if showStructure
                pushLineCapped(structLines, line.new(lastExtLowBar, lastExtLow, bar_index, lastExtLow, xloc.bar_index, extend.none, bearOrderBlockColor, line.style_solid, 1), maxStructDrawings)
                pushLabelCapped(structLabels, label.new(bar_index, lastExtLow, "BOS", xloc.bar_index, yloc.price, #00000000, label.style_label_up, structLabelColor, size.small), maxStructDrawings)

    // --- شکست سقف داخلی: CHoCH داخلی (خلاف جهت) یا BOS داخلی (در جهت) ---
    intBullBreak = useInternalStructure and not intHighBroken and not na(lastIntHigh) and chochBullSrc > lastIntHigh
    if intBullBreak
        intHighBroken := true
        if marketDir <= 0
            sweepPre = not chochRequireSweep or (not na(lastBullSweepBar) and bar_index - lastBullSweepBar <= chochWindow)
            dispPost = not chochRequireDisp or bullDisplacement or bullDisplacement[1]
            if sweepPre and dispPost
                marketDir := 1
                lastBullChochBar := bar_index
                if showStructure
                    pushLineCapped(structLines, line.new(lastIntHighBar, lastIntHigh, bar_index, lastIntHigh, xloc.bar_index, extend.none, bullOrderBlockColor, line.style_dashed, 1), maxStructDrawings)
                    pushLabelCapped(structLabels, label.new(bar_index, lastIntHigh, "CHoCH", xloc.bar_index, yloc.price, #00000000, label.style_label_down, structLabelColor, size.small), maxStructDrawings)
        else if bosSwingType != "External" and (not bosRequireDisp or (close > open and bosBodyOK))
            lastBullBOSBar := bar_index

    intBearBreak = useInternalStructure and not intLowBroken and not na(lastIntLow) and chochBearSrc < lastIntLow
    if intBearBreak
        intLowBroken := true
        if marketDir >= 0
            sweepPre = not chochRequireSweep or (not na(lastBearSweepBar) and bar_index - lastBearSweepBar <= chochWindow)
            dispPost = not chochRequireDisp or bearDisplacement or bearDisplacement[1]
            if sweepPre and dispPost
                marketDir := -1
                lastBearChochBar := bar_index
                if showStructure
                    pushLineCapped(structLines, line.new(lastIntLowBar, lastIntLow, bar_index, lastIntLow, xloc.bar_index, extend.none, bearOrderBlockColor, line.style_dashed, 1), maxStructDrawings)
                    pushLabelCapped(structLabels, label.new(bar_index, lastIntLow, "CHoCH", xloc.bar_index, yloc.price, #00000000, label.style_label_up, structLabelColor, size.small), maxStructDrawings)
        else if bosSwingType != "External" and (not bosRequireDisp or (close < open and bosBodyOK))
            lastBearBOSBar := bar_index

// --- دیلینگ رنج و اکوییلیبریم ---
drHigh = pdSource == "External Swing" ? nz(lastExtHigh, rangeHigh) : pdSource == "Sweep Range" ? nz(lastSweptBSL, rangeHigh) : rangeHigh
drLow = pdSource == "External Swing" ? nz(lastExtLow, rangeLow) : pdSource == "Sweep Range" ? nz(lastSweptSSL, rangeLow) : rangeLow
equilibrium = math.avg(drHigh, drLow)

var line eqLine = na
var box premBox = na
var box discBox = na
if barstate.islast and showEquilibrium
    line.delete(eqLine)
    eqLine := line.new(bar_index - pdLookback, equilibrium, bar_index + 5, equilibrium, xloc.bar_index, extend.none, structLabelColor, line.style_dashed, 1)
if barstate.islast and showPDBackground
    box.delete(premBox), box.delete(discBox)
    premBox := box.new(bar_index - pdLookback, drHigh, bar_index + 5, equilibrium, xloc = xloc.bar_index, border_color = #00000000, bgcolor = color.new(bearOrderBlockColor, 92))
    discBox := box.new(bar_index - pdLookback, equilibrium, bar_index + 5, drLow, xloc = xloc.bar_index, border_color = #00000000, bgcolor = color.new(bullOrderBlockColor, 92))
// ====================================================================================

findOrderBlocks () =>
    // سوینگ‌های موتور OB باید هر کندل محاسبه شوند
    [top, btm] = findOBSwings(swingLength)
    // فقط کندل تاییدشده → بدون ریپینت
    if bar_index > last_bar_index - maxDistanceToLastBar and barstate.isconfirmed
        max = useBodyOnly ? math.max(close, open) : high
        min = useBodyOnly ? math.min(close, open) : low

        // ================= مدیریت OB های صعودی =================
        if bullishOrderBlocksList.size() > 0
            for i = bullishOrderBlocksList.size() - 1 to 0
                currentOB = bullishOrderBlocksList.get(i)
                removed = false

                invBreak = (invalidationMethod == "Wick" ? low : math.min(open, close)) < currentOB.bottom
                if invBreak
                    if deleteOnInvalidation
                        bullishOrderBlocksList.remove(i)
                        removed := true
                    else
                        currentOB.weak := true

                if not removed and meanMode != "Display Only"
                    if not na(currentOB.meanThreshold) and close < currentOB.meanThreshold
                        if meanMode == "Invalidate"
                            bullishOrderBlocksList.remove(i)
                            removed := true
                        else
                            currentOB.weak := true

                if not removed
                    mitTouch = (mitigationMethod == "Wick" ? low : math.min(open, close)) <= currentOB.top
                    if mitTouch
                        if not currentOB.inZone
                            currentOB.mitigationCount += 1
                            currentOB.inZone := true
                        if deleteOnMitigation or currentOB.mitigationCount > maxMitigations
                            bullishOrderBlocksList.remove(i)
                            removed := true
                        else if markMitigatedOB
                            currentOB.weak := true
                    else
                        currentOB.inZone := false

        // ================= ساخت OB صعودی =================
        if close > top.y and not top.crossed
            top.crossed := true

            // انتخاب کاندیدا بر اساس مود
            extIdx = 1
            extBtm = min[1]
            extTop = max[1]
            extLoc = time[1]
            lastOppIdx = 0
            searchLimit = math.min((bar_index - top.x) - 1, obSearchWindow)

            for i = 1 to math.max((bar_index - top.x) - 1, 1)
                extBtm := math.min(min[i], extBtm)
                extTop := extBtm == min[i] ? max[i] : extTop
                extLoc := extBtm == min[i] ? time[i] : extLoc
                extIdx := extBtm == min[i] ? i : extIdx

            for i = 1 to math.max(searchLimit, 1)
                if lastOppIdx == 0 and close[i] < open[i]
                    lastOppIdx := i

            useIdx = extIdx
            if obCandidateMode == "Last Opposite Candle" and lastOppIdx > 0
                useIdx := lastOppIdx
            if obCandidateMode == "Hybrid"
                useIdx := close[extIdx] < open[extIdx] ? extIdx : (lastOppIdx > 0 ? lastOppIdx : extIdx)

            boxTop = useIdx == extIdx ? extTop : max[useIdx]
            boxBtm = useIdx == extIdx ? extBtm : min[useIdx]
            boxLoc = useIdx == extIdx ? extLoc : time[useIdx]
            obCandleIdx = useIdx

            // حجم فوت‌پرینت از کندل مبدا و دو کندل مجاور (تخمینی — نه bid/ask واقعی)
            buyOBVolume = candleBuyVolume(obCandleIdx) + candleBuyVolume(obCandleIdx + 1) + candleBuyVolume(math.max(obCandleIdx - 1, 0))
            sellOBVolume = candleSellVolume(obCandleIdx) + candleSellVolume(obCandleIdx + 1) + candleSellVolume(math.max(obCandleIdx - 1, 0))
            totalOBVolume = buyOBVolume + sellOBVolume

            obSize = math.abs(boxTop - boxBtm)
            sizeOK = obSize > 0 and obSize <= atr * maxATRMult

            // ---------- اعتبارسنجی توالی ICT ----------
            sweepOK = not na(lastBullSweepBar) and bar_index - lastBullSweepBar <= chochWindow
            chochOK = not na(lastBullChochBar) and bar_index - lastBullChochBar <= chochWindow
            bosOK = not na(lastBullBOSBar) and bar_index - lastBullBOSBar <= chochWindow
            dispOK = bullDisplacement or bullDisplacement[1] or (not na(lastBullDispBar) and bar_index - lastBullDispBar <= 3)
            fvgOK = not na(lastBullFVGBar) and bar_index - lastBullFVGBar <= maxObFvgBars and not (fvgRequireUnfilled and bullFVGFilled)
            insideDiscountPct = boxTop <= equilibrium ? 100.0 : boxBtm >= equilibrium ? 0.0 : (equilibrium - boxBtm) / math.max(boxTop - boxBtm, syminfo.mintick) * 100.0
            pdOK = insideDiscountPct >= pdMinInsidePct
            sellPct = totalOBVolume > 0 ? sellOBVolume / totalOBVolume * 100.0 : 0.0
            // جذب (Absorption): حجم فروش بالا داخل ناحیه ولی قیمت پایین‌تر نرفته و دیسپلیسمنت صعودی آمده
            absOK = totalOBVolume >= nz(volSMA) * absVolSMAMult and sellPct >= absMinOppPct and dispOK

            // ---------- امتیاز 0-15 ----------
            score = 0
            score += sweepOK ? 2 : 0
            score += chochOK ? 2 : 0
            score += bosOK ? 2 : 0
            score += dispOK ? 2 : 0
            score += fvgOK ? 2 : 0
            score += pdOK ? 2 : 0
            score += sizeOK ? 1 : 0
            score += 1 // بدون میتیگیشن
            score += absOK ? 1 : 0

            // ---------- گیت فیلترهای فعال ----------
            passed = sizeOK
            passed := passed and (not sweepEnabled or sweepOK)
            structGate = (chochEnabled and chochOK) or (bosEnabled and bosOK)
            passed := passed and (not requireCauseStructure or not (chochEnabled or bosEnabled) or structGate)
            passed := passed and (not dispEnabled or dispOK)
            passed := passed and (not fvgEnabled or fvgOK)
            passed := passed and (not pdEnabled or pdOK)
            passed := passed and (not absEnabled or absOK)

            isWeakScore = score < minScore
            passed := passed and (not hideBelowScore or not isWeakScore)

            if passed
                newOrderBlockInfo = orderBlockInfo.new(boxTop, boxBtm, totalOBVolume, "Bull", boxLoc)
                newOrderBlockInfo.obHighVolume := buyOBVolume
                newOrderBlockInfo.obLowVolume := sellOBVolume
                newOrderBlockInfo.meanThreshold := (boxTop + boxBtm) / 2
                newOrderBlockInfo.score := score
                newOrderBlockInfo.weak := isWeakScore
                newOrderBlockInfo.tags := buildTags(sweepOK, chochOK, bosOK, dispOK, fvgOK, pdOK, absOK, true)

                bullishOrderBlocksList.unshift(newOrderBlockInfo)
                if bullishOrderBlocksList.size() > maxOrderBlocks
                    bullishOrderBlocksList.pop()

        // ================= مدیریت OB های نزولی =================
        if bearishOrderBlocksList.size() > 0
            for i = bearishOrderBlocksList.size() - 1 to 0
                currentOB = bearishOrderBlocksList.get(i)
                removed = false

                invBreak = (invalidationMethod == "Wick" ? high : math.max(open, close)) > currentOB.top
                if invBreak
                    if deleteOnInvalidation
                        bearishOrderBlocksList.remove(i)
                        removed := true
                    else
                        currentOB.weak := true

                if not removed and meanMode != "Display Only"
                    if not na(currentOB.meanThreshold) and close > currentOB.meanThreshold
                        if meanMode == "Invalidate"
                            bearishOrderBlocksList.remove(i)
                            removed := true
                        else
                            currentOB.weak := true

                if not removed
                    mitTouch = (mitigationMethod == "Wick" ? high : math.max(open, close)) >= currentOB.bottom
                    if mitTouch
                        if not currentOB.inZone
                            currentOB.mitigationCount += 1
                            currentOB.inZone := true
                        if deleteOnMitigation or currentOB.mitigationCount > maxMitigations
                            bearishOrderBlocksList.remove(i)
                            removed := true
                        else if markMitigatedOB
                            currentOB.weak := true
                    else
                        currentOB.inZone := false

        // ================= ساخت OB نزولی =================
        if close < btm.y and not btm.crossed
            btm.crossed := true

            extIdx = 1
            extBtm = min[1]
            extTop = max[1]
            extLoc = time[1]
            lastOppIdx = 0
            searchLimit = math.min((bar_index - btm.x) - 1, obSearchWindow)

            for i = 1 to math.max((bar_index - btm.x) - 1, 1)
                extTop := math.max(max[i], extTop)
                extBtm := extTop == max[i] ? min[i] : extBtm
                extLoc := extTop == max[i] ? time[i] : extLoc
                extIdx := extTop == max[i] ? i : extIdx

            for i = 1 to math.max(searchLimit, 1)
                if lastOppIdx == 0 and close[i] > open[i]
                    lastOppIdx := i

            useIdx = extIdx
            if obCandidateMode == "Last Opposite Candle" and lastOppIdx > 0
                useIdx := lastOppIdx
            if obCandidateMode == "Hybrid"
                useIdx := close[extIdx] > open[extIdx] ? extIdx : (lastOppIdx > 0 ? lastOppIdx : extIdx)

            boxTop = useIdx == extIdx ? extTop : max[useIdx]
            boxBtm = useIdx == extIdx ? extBtm : min[useIdx]
            boxLoc = useIdx == extIdx ? extLoc : time[useIdx]
            obCandleIdx = useIdx

            buyOBVolume = candleBuyVolume(obCandleIdx) + candleBuyVolume(obCandleIdx + 1) + candleBuyVolume(math.max(obCandleIdx - 1, 0))
            sellOBVolume = candleSellVolume(obCandleIdx) + candleSellVolume(obCandleIdx + 1) + candleSellVolume(math.max(obCandleIdx - 1, 0))
            totalOBVolume = buyOBVolume + sellOBVolume

            obSize = math.abs(boxTop - boxBtm)
            sizeOK = obSize > 0 and obSize <= atr * maxATRMult

            sweepOK = not na(lastBearSweepBar) and bar_index - lastBearSweepBar <= chochWindow
            chochOK = not na(lastBearChochBar) and bar_index - lastBearChochBar <= chochWindow
            bosOK = not na(lastBearBOSBar) and bar_index - lastBearBOSBar <= chochWindow
            dispOK = bearDisplacement or bearDisplacement[1] or (not na(lastBearDispBar) and bar_index - lastBearDispBar <= 3)
            fvgOK = not na(lastBearFVGBar) and bar_index - lastBearFVGBar <= maxObFvgBars and not (fvgRequireUnfilled and bearFVGFilled)
            insidePremiumPct = boxBtm >= equilibrium ? 100.0 : boxTop <= equilibrium ? 0.0 : (boxTop - equilibrium) / math.max(boxTop - boxBtm, syminfo.mintick) * 100.0
            pdOK = insidePremiumPct >= pdMinInsidePct
            buyPct = totalOBVolume > 0 ? buyOBVolume / totalOBVolume * 100.0 : 0.0
            absOK = totalOBVolume >= nz(volSMA) * absVolSMAMult and buyPct >= absMinOppPct and dispOK

            score = 0
            score += sweepOK ? 2 : 0
            score += chochOK ? 2 : 0
            score += bosOK ? 2 : 0
            score += dispOK ? 2 : 0
            score += fvgOK ? 2 : 0
            score += pdOK ? 2 : 0
            score += sizeOK ? 1 : 0
            score += 1
            score += absOK ? 1 : 0

            passed = sizeOK
            passed := passed and (not sweepEnabled or sweepOK)
            structGate = (chochEnabled and chochOK) or (bosEnabled and bosOK)
            passed := passed and (not requireCauseStructure or not (chochEnabled or bosEnabled) or structGate)
            passed := passed and (not dispEnabled or dispOK)
            passed := passed and (not fvgEnabled or fvgOK)
            passed := passed and (not pdEnabled or pdOK)
            passed := passed and (not absEnabled or absOK)

            isWeakScore = score < minScore
            passed := passed and (not hideBelowScore or not isWeakScore)

            if passed
                newOrderBlockInfo = orderBlockInfo.new(boxTop, boxBtm, totalOBVolume, "Bear", boxLoc)
                newOrderBlockInfo.obHighVolume := buyOBVolume
                newOrderBlockInfo.obLowVolume := sellOBVolume
                newOrderBlockInfo.meanThreshold := (boxTop + boxBtm) / 2
                newOrderBlockInfo.score := score
                newOrderBlockInfo.weak := isWeakScore
                newOrderBlockInfo.tags := buildTags(sweepOK, chochOK, bosOK, dispOK, fvgOK, pdOK, absOK, false)

                bearishOrderBlocksList.unshift(newOrderBlockInfo)
                if bearishOrderBlocksList.size() > maxOrderBlocks
                    bearishOrderBlocksList.pop()
    true

areaOfOB (orderBlockInfo OBInfoF) =>
    float XA1 = OBInfoF.startTime
    float XA2 = na(OBInfoF.breakTime) ? time + 1 : OBInfoF.breakTime
    float YA1 = OBInfoF.top
    float YA2 = OBInfoF.bottom
    float edge1 = math.sqrt((XA2 - XA1) * (XA2 - XA1) + (YA2 - YA2) * (YA2 - YA2))
    float edge2 = math.sqrt((XA2 - XA2) * (XA2 - XA2) + (YA2 - YA1) * (YA2 - YA1))
    float totalArea = edge1 * edge2
    totalArea

doOBsTouch (orderBlockInfo OBInfo1, orderBlockInfo OBInfo2) =>
    float XA1 = OBInfo1.startTime
    float XA2 = na(OBInfo1.breakTime) ? time + 1 : OBInfo1.breakTime
    float YA1 = OBInfo1.top
    float YA2 = OBInfo1.bottom

    float XB1 = OBInfo2.startTime
    float XB2 = na(OBInfo2.breakTime) ? time + 1 : OBInfo2.breakTime
    float YB1 = OBInfo2.top
    float YB2 = OBInfo2.bottom
    float intersectionArea = math.max(0, math.min(XA2, XB2) - math.max(XA1, XB1)) * math.max(0, math.min(YA1, YB1) - math.max(YA2, YB2))
    float unionArea = areaOfOB(OBInfo1) + areaOfOB(OBInfo2) - intersectionArea

    float overlapPercentage = (intersectionArea / unionArea) * 100.0

    if overlapPercentage > overlapThresholdPercentage
        true
    else
        false

isOBValid (orderBlockInfo OBInfo) =>
    valid = true
    if OBInfo.disabled
        valid := false
    valid

combineOBsFunc () =>
    if allOrderBlocksList.size() > 0
        lastCombinations = 999
        while lastCombinations > 0
            lastCombinations := 0
            for i = 0 to allOrderBlocksList.size() - 1
                curOB1 = allOrderBlocksList.get(i)
                for j = 0 to allOrderBlocksList.size() - 1
                    curOB2 = allOrderBlocksList.get(j)
                    if i == j
                        continue
                    if not isOBValid(curOB1.info) or not isOBValid(curOB2.info)
                        continue
                    if curOB1.info.obType != curOB2.info.obType
                        continue
                    if doOBsTouch(curOB1.info, curOB2.info)
                        curOB1.info.disabled := true
                        curOB2.info.disabled := true
                        orderBlock newOB = createOrderBlock(orderBlockInfo.new(math.max(curOB1.info.top, curOB2.info.top), math.min(curOB1.info.bottom, curOB2.info.bottom), curOB1.info.obVolume + curOB2.info.obVolume, curOB1.info.obType))
                        newOB.info.startTime := math.min(curOB1.info.startTime, curOB2.info.startTime)
                        newOB.info.breakTime := math.max(nz(curOB1.info.breakTime), nz(curOB2.info.breakTime))
                        newOB.info.breakTime := newOB.info.breakTime == 0 ? na : newOB.info.breakTime
                        newOB.info.timeframeStr := curOB1.info.timeframeStr

                        newOB.info.obVolume := curOB1.info.obVolume + curOB2.info.obVolume
                        newOB.info.obLowVolume := curOB1.info.obLowVolume + curOB2.info.obLowVolume
                        newOB.info.obHighVolume := curOB1.info.obHighVolume + curOB2.info.obHighVolume
                        newOB.info.bbVolume := nz(curOB1.info.bbVolume, 0) + nz(curOB2.info.bbVolume, 0)
                        newOB.info.breaker := curOB1.info.breaker or curOB2.info.breaker

                        newOB.info.meanThreshold := (newOB.info.top + newOB.info.bottom) / 2
                        newOB.info.score := math.max(curOB1.info.score, curOB2.info.score)
                        newOB.info.tags := str.length(curOB1.info.tags) >= str.length(curOB2.info.tags) ? curOB1.info.tags : curOB2.info.tags
                        newOB.info.mitigationCount := math.max(curOB1.info.mitigationCount, curOB2.info.mitigationCount)
                        newOB.info.weak := curOB1.info.weak and curOB2.info.weak

                        newOB.info.combined := true
                        if timeframe.in_seconds(curOB1.info.timeframeStr) != timeframe.in_seconds(curOB2.info.timeframeStr)
                            newOB.info.combinedTimeframesStr := (na(curOB1.info.combinedTimeframesStr) ? formatTimeframeString(curOB1.info.timeframeStr) : curOB1.info.combinedTimeframesStr) + " & " + (na(curOB2.info.combinedTimeframesStr) ? formatTimeframeString(curOB2.info.timeframeStr) : curOB2.info.combinedTimeframesStr)
                        allOrderBlocksList.unshift(newOB)
                        lastCombinations += 1


// نکته: چون تایم‌فریم همیشه تایم‌فریم خود چارت است (timeframe1 = "")، نیازی به request.security نیست.
// حذف security این امکان را می‌دهد که موتور نقدینگی/ساختار آزادانه خط و برچسب رسم کند.
getTFData (timeframeInfo timeframeInfoF, timeframeStr) =>
    if not isTimeframeLower(timeframeInfoF.timeframeStr, timeframe.period) and timeframeInfoF.isEnabled
        [bullishOrderBlocksList, bearishOrderBlocksList]
    else
        [na, na]

handleTimeframeInfo (timeframeInfo timeframeInfoF, bullishOrderBlocksListF, bearishOrderBlocksListF) =>
    if not isTimeframeLower(timeframeInfoF.timeframeStr, timeframe.period) and timeframeInfoF.isEnabled
        timeframeInfoF.bullishOrderBlocksList := bullishOrderBlocksListF
        timeframeInfoF.bearishOrderBlocksList := bearishOrderBlocksListF


handleOrderBlocksFinal () =>
    if allOrderBlocksList.size () > 0
        for i = 0 to allOrderBlocksList.size() - 1
            safeDeleteOrderBlock(allOrderBlocksList.get(i))
    allOrderBlocksList.clear()

    for i = 0 to timeframeInfos.size() - 1
        curTimeframe = timeframeInfos.get(i)
        if not curTimeframe.isEnabled
            continue
        if curTimeframe.bullishOrderBlocksList.size() > 0
            for j = 0 to math.min(curTimeframe.bullishOrderBlocksList.size() - 1, bullishOrderBlocks - 1)
                orderBlockInfoF = curTimeframe.bullishOrderBlocksList.get(j)
                orderBlockInfoF.timeframeStr := curTimeframe.timeframeStr
                allOrderBlocksList.unshift(createOrderBlock(orderBlockInfo.copy(orderBlockInfoF)))

        if curTimeframe.bearishOrderBlocksList.size() > 0
            for j = 0 to math.min(curTimeframe.bearishOrderBlocksList.size() - 1, bearishOrderBlocks - 1)
                orderBlockInfoF = curTimeframe.bearishOrderBlocksList.get(j)
                orderBlockInfoF.timeframeStr := curTimeframe.timeframeStr
                allOrderBlocksList.unshift(createOrderBlock(orderBlockInfo.copy(orderBlockInfoF)))

    if combineOBs
        combineOBsFunc()

    if allOrderBlocksList.size() > 0
        for i = 0 to allOrderBlocksList.size() - 1
            curOB = allOrderBlocksList.get(i)
            if isOBValid(curOB.info)
                renderOrderBlock(curOB)

findOrderBlocks()

[bullishOrderBlocksListTimeframe1, bearishOrderBlocksListTimeframe1] = getTFData(timeframeInfos.get(0), timeframe1)

if barstate.isconfirmed
    handleTimeframeInfo(timeframeInfos.get(0), bullishOrderBlocksListTimeframe1, bearishOrderBlocksListTimeframe1)
    handleOrderBlocksFinal()
